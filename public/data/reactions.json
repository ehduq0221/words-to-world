{
  "note": "학생 민원·칭찬 조건, 학사 일정 반응, 학생 인물 설정입니다. 모두 게임 균형과 표현을 위한 설정값입니다. 학사 일정 날짜는 게임용 대표 날짜입니다.",
  "checkEveryDays": 7,
  "remindEveryDays": 28,
  "maxFeed": 40,
  "recentLines": 8,
  "panelSize": 5,
  "rules": [
    {
      "id": "dorm-shortage",
      "each": "operations.summary.dorms",
      "when": [{ "field": "waiting", "op": ">", "value": 0 }],
      "levels": [{ "field": "waiting", "op": ">=", "value": 300 }],
      "type": "dorm.shortage",
      "cause": "기숙사 수용 인원",
      "values": { "building": "name", "value": "waiting", "applicants": "applicants", "openBeds": "openBeds" },
      "persona": { "role": "기숙사 입사 대기 학생" }
    },
    {
      "id": "dorm-closed",
      "each": "operations.summary.dorms",
      "when": [{ "field": "openBeds", "op": "<", "valueField": "capacity" }, { "field": "waiting", "op": ">", "value": 0 }],
      "type": "dorm.closed",
      "cause": "닫아 둔 기숙사 방",
      "values": { "building": "name", "value": "waiting", "applicants": "applicants", "openBeds": "openBeds" },
      "persona": { "role": "기숙사 입사 대기 학생" }
    },
    {
      "id": "dorm-fee",
      "path": "operations.summary.feeLevel",
      "when": [{ "op": "==", "value": "high" }],
      "type": "dorm.fee",
      "cause": "기숙사비",
      "persona": { "role": "기숙사 거주 학생" }
    },
    {
      "id": "dorm-fee-low",
      "kind": "praise",
      "path": "operations.summary.feeLevel",
      "when": [{ "op": "==", "value": "low" }],
      "type": "dorm.fee-low",
      "cause": "기숙사비",
      "persona": { "role": "기숙사 거주 학생" }
    },
    {
      "id": "cafeteria-lease",
      "each": "operations.summary.facilities",
      "when": [{ "field": "type", "op": "==", "value": "cafeteria" }, { "field": "mode", "op": "==", "value": "lease" }],
      "type": "food.price",
      "cause": "학생식당 가격",
      "values": { "building": "name" }
    },
    {
      "id": "convenience-low",
      "path": "operations.summary.convenience",
      "when": [{ "op": "<", "value": 68 }],
      "levels": [{ "op": "<", "value": 60 }],
      "type": "convenience.low",
      "cause": "편의시설"
    },
    {
      "id": "convenience-high",
      "kind": "praise",
      "path": "operations.summary.convenience",
      "when": [{ "op": ">=", "value": 80 }],
      "type": "convenience.high",
      "cause": "편의시설"
    },
    {
      "id": "housing-low",
      "path": "operations.summary.housing",
      "when": [{ "op": "<", "value": 55 }],
      "levels": [{ "op": "<", "value": 40 }],
      "type": "housing.low",
      "cause": "주거 만족도",
      "persona": { "role": "기숙사 거주 학생" }
    },
    {
      "id": "housing-high",
      "kind": "praise",
      "path": "operations.summary.housing",
      "when": [{ "op": ">=", "value": 82 }],
      "type": "housing.high",
      "cause": "주거 만족도",
      "persona": { "role": "기숙사 거주 학생" }
    },
    {
      "id": "satisfaction-low",
      "path": "metrics.satisfaction",
      "when": [{ "op": "<", "value": 45 }],
      "levels": [{ "op": "<", "value": 35 }],
      "type": "satisfaction.low",
      "cause": "학생 만족도"
    },
    {
      "id": "satisfaction-high",
      "kind": "praise",
      "path": "metrics.satisfaction",
      "when": [{ "op": ">=", "value": 75 }],
      "type": "satisfaction.high",
      "cause": "학생 만족도"
    },
    {
      "id": "reputation-low",
      "path": "metrics.reputation",
      "when": [{ "op": "<", "value": 40 }],
      "type": "reputation.low",
      "cause": "학교 평판"
    },
    {
      "id": "reputation-high",
      "kind": "praise",
      "path": "metrics.reputation",
      "when": [{ "op": ">=", "value": 75 }],
      "type": "reputation.high",
      "cause": "학교 평판"
    },
    {
      "id": "budget-deficit",
      "path": "metrics.budget",
      "when": [{ "op": "<", "value": 0 }],
      "type": "budget.deficit",
      "cause": "학교 재정",
      "persona": { "role": "총학생회 학생" }
    }
  ],
  "calendar": [
    { "month": 2, "day": 20, "type": "calendar.orientation", "cause": "새내기 준비", "label": "학사 일정", "persona": { "role": "새내기" } },
    { "month": 3, "day": 9, "type": "calendar.course", "cause": "수강 정정", "label": "학사 일정" },
