    { "month": 4, "day": 20, "type": "calendar.midterm", "cause": "중간고사", "label": "학사 일정", "buildingId": "way/367504016", "values": { "building": "학산도서관" } },
    { "month": 5, "day": 18, "type": "calendar.festival-soon", "cause": "축제", "label": "캠퍼스 생활" },
    { "month": 6, "day": 15, "type": "calendar.final", "cause": "기말고사", "label": "학사 일정", "buildingId": "way/367504016", "values": { "building": "학산도서관" } },
    { "month": 6, "day": 24, "type": "calendar.summer", "cause": "여름방학", "label": "학사 일정" },
    { "month": 8, "day": 24, "type": "calendar.term-soon", "cause": "개강 준비", "label": "학사 일정" },
    { "month": 9, "day": 1, "type": "calendar.second-term", "cause": "2학기 개강", "label": "학사 일정" },
    { "month": 10, "day": 20, "type": "calendar.midterm", "cause": "중간고사", "label": "학사 일정", "buildingId": "way/367504016", "values": { "building": "학산도서관" } },
    { "month": 11, "day": 20, "type": "calendar.cold", "cause": "송도 바닷바람", "label": "캠퍼스 생활" },
    { "month": 12, "day": 14, "type": "calendar.final", "cause": "기말고사", "label": "학사 일정", "buildingId": "way/367504016", "values": { "building": "학산도서관" } },
    { "month": 12, "day": 22, "type": "calendar.winter", "cause": "겨울방학", "label": "학사 일정" }
  ],
  "personas": {
    "surnames": ["김", "이", "박", "최", "정", "강", "조", "윤", "장", "임", "한", "오", "서", "신", "권", "황"],
